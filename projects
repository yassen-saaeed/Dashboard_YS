                                style={{ fontFamily: 'var(--font-body)', color: '#6b7280' }}
                            >
                                {p.description}
                            </p>
                            <div className="flex items-center justify-between">
                                <span
                                    className="text-[14px] font-semibold"
                                    style={{ fontFamily: 'var(--font-body)', color: 'var(--color-gold)' }}
                                >
                                    {p.price}
                                </span>
                                <a
                                    href="#"
                                    className="uppercase tracking-[0.25em] text-[10px]"
                                    style={{ fontFamily: 'var(--font-body)', color: 'var(--color-dark)' }}
                                    aria-label={`View property: ${p.name}`}
                                >
                                    View →
                                </a>
                            </div>
                        </div>
                    </article>
                ))}
            </div>

            {/* ── CTA ──────────────────────────────────────────────────────────── */}
            <div
                ref={ctaRef}
                className="flex justify-center py-20 md:py-28"
                style={{ backgroundColor: '#FFFFFF' }}
            >
                <MagneticButton />
            </div>
        </section>
    )
}
 
