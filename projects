                    style={{ fontFamily: 'var(--font-body)', color: 'var(--color-gold)' }}
                >
                    Our Portfolio
                </p>
                <h2
                    ref={headlineRef}
                    className="font-light leading-[1.1] max-w-2xl"
                    style={{
                        fontFamily: 'var(--font-display)',
                        fontSize: 'clamp(36px, 5vw, 64px)',
                        color: 'var(--color-dark)',
                    }}
                >
                    Exceptional Properties<br />Across Switzerland.
                </h2>
            </div>

            {/* ── Desktop pinned slider ────────────────────────────────────────── */}
            <div
                ref={sliderRef}
                className="hidden md:block relative w-full overflow-hidden"
                style={{ height: '100vh' }}
                aria-label="Property portfolio slider"
            >
                {/* Image column */}
                <div
                    className="absolute left-0 top-0 bottom-0 drag-area"
                    style={{ width: '58%' }}
                >
                    {projects.map((p, i) => (
                        <div
                            key={p.id}
                            ref={(el) => { imageRefs.current[i] = el }}
                            className="absolute inset-0"
                            style={{ zIndex: 0 }}
                            aria-hidden="true"
                        >
                            {/* Inner div for independent scale animation */}
                            <div
                                ref={(el) => { innerImgRefs.current[i] = el }}
                                className="absolute inset-0"
                                style={{ background: p.gradient, transformOrigin: 'center center' }}
                            />
