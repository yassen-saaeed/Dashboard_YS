// ── Magnetic CTA ─────────────────────────────────────────────────────────
function MagneticButton() {
    const btnRef = useRef<HTMLButtonElement>(null)
    const textRef = useRef<HTMLSpanElement>(null)

    useEffect(() => {
        const btn = btnRef.current
        if (!btn) return

        const onMove = (e: MouseEvent) => {
            const rect = btn.getBoundingClientRect()
            const x = e.clientX - rect.left - rect.width / 2
            const y = e.clientY - rect.top - rect.height / 2
            gsap.to(btn, { x: x * 0.3, y: y * 0.3, duration: 0.3, ease: 'power1.out' })
            gsap.to(textRef.current, { x: x * 0.1, y: y * 0.1, duration: 0.3, ease: 'power1.out' })
        }
        const onLeave = () => {
            gsap.to(btn, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' })
            gsap.to(textRef.current, { x: 0, y: 0, duration: 0.7, ease: 'elastic.out(1, 0.3)' })
        }

        btn.addEventListener('mousemove', onMove)
        btn.addEventListener('mouseleave', onLeave)
        return () => {
            btn.removeEventListener('mousemove', onMove)
            btn.removeEventListener('mouseleave', onLeave)
        }
    }, [])

    return (
        <button
            ref={btnRef}
            className="relative inline-flex items-center justify-center px-10 py-4 rounded-[2px] overflow-hidden group"
            style={{
                border: '1px solid var(--color-gold)',
                backgroundColor: 'transparent',
                willChange: 'transform',
            }}
            aria-label="Browse all properties"
        >
            {/* Fill on hover */}
            <span
                className="absolute inset-0 origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-500"
                style={{ backgroundColor: 'var(--color-gold)', transitionTimingFunction: 'var(--ease-luxury)' }}
                aria-hidden="true"
            />
            <span
                ref={textRef}
                className="relative uppercase tracking-[0.3em] text-[12px] transition-colors duration-300"
                style={{
                    fontFamily: 'var(--font-body)',
                    color: 'var(--color-gold)',
                    willChange: 'transform',
                }}
            >
                Browse All Properties
            </span>
        </button>
    )
}

// ── Section ───────────────────────────────────────────────────────────────
export default function Projects({ isReady }: ProjectsProps) {
    const sectionRef = useRef<HTMLElement>(null)
    const headerRef = useRef<HTMLDivElement>(null)
    const eyebrowRef = useRef<HTMLParagraphElement>(null)
    const headlineRef = useRef<HTMLHeadingElement>(null)
    const sliderRef = useRef<HTMLDivElement>(null)
    const imageRefs = useRef<(HTMLDivElement | null)[]>([])
    const innerImgRefs = useRef<(HTMLDivElement | null)[]>([])
    const infoRefs = useRef<(HTMLDivElement | null)[]>([])
    const counterNumRef = useRef<HTMLSpanElement>(null)
    const progressRef = useRef<HTMLDivElement>(null)
    const navDotsRef = useRef<(HTMLButtonElement | null)[]>([])
    const activeIndexRef = useRef(0)
    const ctaRef = useRef<HTMLDivElement>(null)

    // ── Transition logic ────────────────────────────────────────────────────
    const transitionTo = useCallback((from: number, to: number) => {
        if (from === to) return
        const fromImg = imageRefs.current[from]
        const toImg = imageRefs.current[to]
        const fromInner = innerImgRefs.current[from]
        const toInner = innerImgRefs.current[to]
        const fromInfo = infoRefs.current[from]
        const toInfo = infoRefs.current[to]

        // Kill in-flight tweens on the affected elements
        if (fromImg) gsap.killTweensOf(fromImg)
        if (toImg) gsap.killTweensOf(toImg)
        if (fromInfo) gsap.killTweensOf(fromInfo.querySelectorAll('.info-item'))
        if (toInfo) gsap.killTweensOf(toInfo.querySelectorAll('.info-item'))

        // Image: outgoing fades + slight zoom
        if (fromImg) gsap.to(fromImg, { opacity: 0, duration: 0.65, ease: 'power2.inOut', zIndex: 1 })
        if (fromInner) gsap.to(fromInner, { scale: 1.06, duration: 0.65, ease: 'power2.inOut' })

        // Image: incoming reveals with inverse scale
        if (toImg) {
            gsap.set(toImg, { opacity: 0, zIndex: 2 })
            gsap.to(toImg, { opacity: 1, duration: 0.65, ease: 'power2.inOut' })
        }
        if (toInner) {
            gsap.set(toInner, { scale: 1.08 })
            gsap.to(toInner, { scale: 1, duration: 0.9, ease: 'power2.out' })
        }

        // Info: outgoing
        if (fromInfo) {
            const dir = to > from ? -1 : 1
            gsap.to(fromInfo.querySelectorAll('.info-item'), {
                y: dir * -25,
                opacity: 0,
                stagger: 0.03,
                duration: 0.28,
                ease: 'power2.in',
                onComplete: () => gsap.set(fromInfo, { zIndex: 0 }),
            })
        }

        // Info: incoming
        if (toInfo) {
            const dir = to > from ? 1 : -1
            gsap.set(toInfo, { zIndex: 1 })
            gsap.fromTo(
                toInfo.querySelectorAll('.info-item'),
                { y: dir * 35, opacity: 0 },
                { y: 0, opacity: 1, stagger: 0.06, duration: 0.65, delay: 0.18, ease: 'power3.out' }
            )
        }

        // Counter
        if (counterNumRef.current) {
            gsap.to(counterNumRef.current, {
                opacity: 0, y: -8, duration: 0.15, onComplete: () => {
                    if (counterNumRef.current) {
                        counterNumRef.current.textContent = projects[to].number
                        gsap.to(counterNumRef.current, { opacity: 1, y: 0, duration: 0.25 })
                    }
                },
            })
        }

        // Nav dots
        navDotsRef.current.forEach((dot, i) => {
            if (!dot) return
            dot.style.backgroundColor = i === to ? 'var(--color-gold)' : 'transparent'
            dot.style.borderColor = i === to ? 'var(--color-gold)' : '#4b5563'
        })

        activeIndexRef.current = to
    }, [])

    // ── Keyboard navigation ─────────────────────────────────────────────────
    useEffect(() => {
        if (!isReady) return
        const onKey = (e: KeyboardEvent) => {
            const slider = sliderRef.current
            if (!slider) return
            const rect = slider.getBoundingClientRect()
            // Only intercept when the pinned section is in the viewport
            if (rect.top > 10 || rect.top < -10) return
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
                const next = Math.min(projects.length - 1, activeIndexRef.current + 1)
                transitionTo(activeIndexRef.current, next)
            }
            if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
                const prev = Math.max(0, activeIndexRef.current - 1)
                transitionTo(activeIndexRef.current, prev)
            }
        }
        window.addEventListener('keydown', onKey)
        return () => window.removeEventListener('keydown', onKey)
    }, [isReady, transitionTo])

    // ── Scroll trigger — pinned slider ──────────────────────────────────────
    useEffect(() => {
        if (!isReady || !sliderRef.current) return
        const isMobile = window.matchMedia('(max-width: 768px)').matches
        if (isMobile) return

        // Set initial DOM state
        imageRefs.current.forEach((img, i) => {
            if (img) gsap.set(img, { opacity: i === 0 ? 1 : 0, zIndex: i === 0 ? 2 : 0 })
        })
        innerImgRefs.current.forEach((inner) => {
            if (inner) gsap.set(inner, { scale: 1 })
        })
        infoRefs.current.forEach((info, i) => {
            if (!info) return
            const items = info.querySelectorAll('.info-item')
            gsap.set(items, { opacity: i === 0 ? 1 : 0, y: i === 0 ? 0 : 35 })
            gsap.set(info, { zIndex: i === 0 ? 1 : 0 })
        })
        navDotsRef.current.forEach((dot, i) => {
            if (!dot) return
            dot.style.backgroundColor = i === 0 ? 'var(--color-gold)' : 'transparent'
            dot.style.borderColor = i === 0 ? 'var(--color-gold)' : '#4b5563'
        })

        const ctx = gsap.context(() => {
            ScrollTrigger.create({
                trigger: sliderRef.current,
                pin: true,
                pinSpacing: true,
                start: 'top top',
                end: `+=${projects.length * SCROLL_PER_PROJECT}`,
                scrub: 1,
                onUpdate: (self) => {
                    // Progress bar
                    if (progressRef.current) {
                        progressRef.current.style.transform = `scaleX(${self.progress})`
                    }

                    const raw = self.progress * projects.length
                    const newIndex = Math.min(projects.length - 1, Math.floor(raw))

                    if (newIndex !== activeIndexRef.current) {
                        transitionTo(activeIndexRef.current, newIndex)
                    }
                },
            })
        }, sliderRef)

        return () => ctx.revert()
    }, [isReady, transitionTo])

    // ── Header entrance ──────────────────────────────────────────────────────
    useEffect(() => {
        if (!isReady || !eyebrowRef.current || !headlineRef.current) return
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

        const ctx = gsap.context(() => {
            if (prefersReduced) {
                gsap.set([eyebrowRef.current, headlineRef.current], { opacity: 1 })
                return
            }

            gsap.from(eyebrowRef.current, {
                x: -20, opacity: 0, duration: 0.8, ease: 'power2.out',
                scrollTrigger: { trigger: headerRef.current, start: 'top 85%' },
            })

            const split = new SplitText(headlineRef.current!, { type: 'lines' })
            gsap.from(split.lines, {
                y: 50, opacity: 0, stagger: 0.15, duration: 1.1, ease: 'power3.out',
                scrollTrigger: { trigger: headerRef.current, start: 'top 85%' },
            })
        }, headerRef)

        return () => ctx.revert()
    }, [isReady])

    // ── CTA entrance ─────────────────────────────────────────────────────────
    useEffect(() => {
        if (!isReady || !ctaRef.current) return
        gsap.from(ctaRef.current, {
            opacity: 0, y: 30, duration: 0.9, ease: 'power2.out',
            scrollTrigger: { trigger: ctaRef.current, start: 'top 90%' },
        })
    }, [isReady])

    return (
        <section
            id="scene-5"
            ref={sectionRef}
            style={{ backgroundColor: '#FFFFFF' }}
        >
            {/* ── Header ──────────────────────────────────────────────────────── */}
            <div
